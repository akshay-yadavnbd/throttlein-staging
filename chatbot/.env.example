# ===== Throttlein Assistant (chatbot/) =====
# Separate service: talks to Groq and to the Throttlein API as the signed-in
# user. It has no database connection by design.
PORT=5100
NODE_ENV=development

# The Throttlein API base, ending in /api. The assistant calls it with the
# user's own JWT, so the API's ownership rules apply to every tool call.
BACKEND_API_URL=http://localhost:5000/api

# Groq. The model must support tool calling (qwen/qwen3.8-27b does).
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_TIMEOUT_MS=45000
# GROQ_MAX_TOKENS=1500

# Signs the confirmations that make a previewed change applicable. >= 32 chars.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHATBOT_SECRET=

# Browser origins allowed to call /chat (the dashboards). localhost:3000/3001
# are added automatically outside production.
ALLOWED_ORIGINS=https://throttlein.com,https://seller.throttlein.com,https://admin.throttlein.com

# Per-user chat messages per minute.
# CHAT_MESSAGES_PER_MINUTE=20
