{
  "name": "seller-management-backend",
  "version": "1.0.0",
  "description": "Seller Management System - REST API (Express + MongoDB)",
  "main": "dist/index.js",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "nodemon src/index.js",
    "seed": "node src/database/seed/seedAdmin.js",
    "seed:products": "node src/database/seed/seedSampleProducts.js",
    "seed:demo": "node src/database/seed/seedDemoData.js",
    "seed:bikes": "node src/database/seed/seedBikes.js",
    "seed:bike-icons": "node src/database/seed/seedBikeIcons.js",
    "seed:bike-logos": "node src/database/seed/seedBikeLogos.js",
    "seed:products-demo": "node src/database/seed/seedDemoProducts.js",
    "seed:jacket-subs": "node src/database/seed/seedJacketSubcategories.js",
    "repair:blog-dates": "node scripts/repair-blog-timestamps.js",
    "repair:order-status": "node scripts/recompute-order-status.js",
    "seed:boots-subs": "node src/database/seed/seedBootsSubcategories.js",
    "test:smtp": "node src/utils/testSmtp.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate:site": "node scripts/migrateSiteField.js",
    "migrate:seller-meta": "node scripts/migrateSellerStaticMeta.js",
    "migrate:seller-pages": "node scripts/migrateSellerSystemPages.js",
    "s3:cleanup": "node scripts/cleanupOrphanedS3Objects.js",
    "s3:inspect": "node scripts/inspectS3Layout.js",
    "s3:list-products": "node scripts/listProductsFolder.js",
    "backfill:gateway-fees": "node scripts/backfill-gateway-fees.js",
    "backfill:courier-charges": "node scripts/backfill-courier-charges.js",
    "resume:order": "node scripts/resume-cancelled-order.js",
    "repair:test-scans": "node scripts/remove-test-scans.js",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "@aws-sdk/s3-request-presigner": "^3.1086.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.1",
    "csv-stringify": "^6.8.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "multer": "^2.5.0",
    "multer-s3": "^3.0.1",
    "nodemailer": "^10.1.4",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "razorpay": "^2.9.6",
    "sharp": "^0.35.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
