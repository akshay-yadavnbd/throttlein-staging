# ===== Backend Environment =====
NODE_ENV=
PORT=
# APP_ENV (production | staging) is set by docker-compose.yml from the deploy
# target, not here. Staging keeps NODE_ENV=production and uses APP_ENV=staging
# so SHIPROCKET_MOCK_MODE=true is allowed there. See src/config/appEnv.js.
# APP_ENV=
# pino log level: fatal | error | warn | info (default) | debug | trace | silent
LOG_LEVEL=

# MongoDB Atlas connection
# Use a dedicated least-privilege database user. Transactions require a replica set.
MONGO_URI=
REDIS_HOST=
REDIS_PORT=
REDIS_DB=

HOST=
EMAIL_PORT=
SECURE=
EMAIL=
PASS=
FROM=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=

# Super admin (auto-seeded on startup)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=

# CORS - origins of admin panel and frontend
ADMIN_ORIGIN=
FRONTEND_ORIGIN=

# ADMIN_ORIGIN=https://admin.throttlein.com
# FRONTEND_ORIGIN=https://throttlein.com
# SELLER_ORIGIN=https://seller.throttlein.com

# File uploads
UPLOAD_DIR=
MAX_FILE_SIZE_MB=

# ===== AWS S3 — product image storage =====
# Keep credentials in the deployment secret manager. Never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=
# Folder inside the bucket for this environment, e.g. "staging". Production
# leaves it empty. Objects are read and written under <prefix>/…; keys stored
# in the database stay bare, so the same data works with any prefix.
S3_KEY_PREFIX=

# Force local-disk uploads while S3 IAM is being sorted.
# Remove this line (or set to false) once s3:PutObject is granted on the bucket.


#Shiprocket API credentials (for shipping integration)
SHIPROCKET_API_BASE=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# When true, every Shiprocket API call is short-circuited with realistic fake
# responses — no real wallet charges, no real AWBs, no real couriers. Great
# for developing on localhost without burning balance. Set to false (or remove)
# in production (the API refuses to start otherwise). Allowed on staging.
# Default OFF means live calls.
SHIPROCKET_MOCK_MODE=
# Public origin of this API, used for mock Shiprocket label/tracking links
# (e.g. https://api.staging.throttlein.com). Defaults to localhost.
BACKEND_PUBLIC_URL=

# ===== Razorpay payment gateway =====
# Test keys for development. Get production keys from
# https://dashboard.razorpay.com/app/keys and rotate before going live.
# IMPORTANT: never expose RAZORPAY_KEY_SECRET to the frontend — only the
# backend uses it (for order creation + signature verification).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=


# Optional webhook secret — paste into Razorpay dashboard Settings → Webhooks
# and we'll verify the X-Razorpay-Signature header against this on inbound
# events (payment.authorized, payment.failed, refund.processed, etc.).
RAZORPAY_WEBHOOK_SECRET=

# Tag each Razorpay order/refund with the site source so the dashboard can
# filter revenue per-site. Set a different value on each website that
# shares this Razorpay account (e.g. site-b on the other backend).
PAYMENT_SOURCE_TAG=

# Support address printed on GST tax invoices (services/taxInvoice.js).
# Defaults to info@throttlein.com.
INVOICE_SUPPORT_EMAIL=

# Shared secret for inbound webhooks. Pick any long random string and paste
# the same value into the Shiprocket dashboard as the
# x-api-key header (Settings → Additional Settings → Webhooks, Auth Token Type
# = x-api-key). Required everywhere: with it empty the endpoint answers 503
# (fail closed), except on a non-production server with SHIPROCKET_MOCK_MODE=true.
SHIPROCKET_WEBHOOK_TOKEN=
# Background shipment worker (runs inside the API process every 5s): drains
# the durable webhook inbox, resumes Shiprocket order creation after a
# restart, and polls carrier tracking for parcels whose webhook was missed.
# Set to false only when running several API instances that share one DB
# and you want a single dedicated instance to run it.
SHIPMENT_WORKER_ENABLED=
# Set to 1 to log one line per accepted webhook (event id + scan count; the
# payload itself is never logged). Leave empty in production.
WEBHOOK_DEBUG=
# ===== ISR revalidation =====
# Shared with frontend/.env. Backend POSTs to FRONTEND_ORIGIN/api/revalidate
# with this in the Authorization header after admin saves so the storefront
# regenerates ISR pages immediately instead of waiting for the cache window.
REVALIDATE_SECRET=

# Teams: seller registration + KYC alerts. Paste the channel's Workflow URL.
# Leave empty to disable Teams; existing emails continue as normal.
# Keep the real URL in the deployment environment, never in Git.
TEAMS_SELLER_WEBHOOK_URL=

# ===== Seller product import from URL (docs/product-url-import.md) =====
# Groq API key from https://console.groq.com/keys. Backend only — never NEXT_PUBLIC_*.
# Leave empty to disable the "Fetch product details" feature (returns 503).
GROQ_API_KEY=
# Must support strict json_schema structured outputs. qwen/qwen3.8-27b is a
# preview model; see docs for fallbacks if Groq retires it.
GROQ_PRODUCT_IMPORT_MODEL=qwen/qwen3.8-27b
# Size of the page evidence sent to the model and the answer budget. Defaults (22000 / 18000 chars,
# 4500 tokens) need a paid Groq tier; the free tier (~8k tokens per request and per minute)
# works with about 7000 / 5000 / 2000.
# PRODUCT_IMPORT_TEXT_CHARS=22000
# PRODUCT_IMPORT_STRUCTURED_CHARS=18000
# PRODUCT_IMPORT_MAX_OUTPUT_TOKENS=4500

# ===== MCP connector (docs/mcp-server.md) =====
# Lets claude.ai / Claude Code query operations data as the signed-in staff
# member. Off until a superadmin switches it on from the admin API (fail closed).
# Public https origin of this API as AI apps reach it, e.g. https://api.throttlein.com.
# OAuth discovery metadata and token audience are built from it. Required in
# production; locally http://localhost:5000 is fine.
MCP_ISSUER_URL=
# One secret, >= 32 random bytes (hex or base64). Sub-keys for token hashing, audit
# MACs and cursors are derived from it; rotating it ends every connection.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_MASTER_KEY=
# Ceiling for what the superadmin setting may enable: off | read (write does not exist yet).
MCP_MAX_MODE=read
# Ceilings for limits (settings may lower them, never raise): calls/min per connection
# and per person, records/day, concurrent calls, response bytes, page size, timeout.
# MCP_RATE_PER_MIN=60  MCP_USER_RATE_PER_MIN=120  MCP_DAILY_RECORDS=5000  MCP_MAX_CONCURRENT=4
# MCP_MAX_RESPONSE_BYTES=65536  MCP_MAX_PAGE_SIZE=50  MCP_TOOL_TIMEOUT_MS=15000
# Access token lifetime and the longest approval a superadmin may set (days).
# MCP_OAUTH_ACCESS_SECONDS=3600  MCP_OAUTH_MAX_DAYS=30

