NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_UPLOADS_URL=
NEXT_PUBLIC_APP_NAME=
 
# Shared with backend/.env. Protects POST /api/revalidate so only our
# backend can trigger an ISR refresh. Must be the SAME value as
# REVALIDATE_SECRET in backend/.env.
REVALIDATE_SECRET=

# Throttlein Assistant (chatbot/) service origin; the floating AI widget loads from here.
NEXT_PUBLIC_CHATBOT_URL=http://localhost:5100
