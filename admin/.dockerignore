# Local dev artifacts — never copy these into a Docker build context.
# `node_modules` and `.next` get re-created inside the build stage from
# a clean `npm ci`, so shipping them from the host would slow uploads
# and risk mixing host-specific binaries (sharp, etc.) into the image.

node_modules
.next
.next-build
out

# Env files — secrets stay out of images. NEXT_PUBLIC_* values are passed
# via --build-arg at build time (see Dockerfile).
.env
.env.*
!.env.example

# Version control + editor noise
.git
.gitignore
.gitattributes
.vscode
.idea
*.swp
.DS_Store

# Logs / CI / docs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
coverage
README.md
Dockerfile
.dockerignore
